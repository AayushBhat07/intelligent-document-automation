# .gitignore for Google Apps Script Add-on

# Clasp
.clasp.json
.claspignore

# Node modules
node_modules/
package-lock.json
yarn.lock

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Build artifacts
dist/
build/

# Temporary files
tmp/
temp/
*.tmp

# Coverage reports
coverage/
.nyc_output/

# Apps Script local copies
**/*.gs.json
